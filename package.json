    "description":  "Aangan AI: phone enquiry handling, qualification and designer handoff for Aangan Studio (MESA AI \u0026 Its Applications, Case 03)",
    "scripts":  {
                    "embed-knowledge":  "node node_modules/tsx/dist/cli.mjs scripts/embed-knowledge.mts",
                    "predev":  "npm run embed-knowledge",
