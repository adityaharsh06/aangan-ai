/**
 * Embeds the business source-of-truth files (knowledge/*.md) into a generated TS module
 * with a content hash, so every enquiry records exactly which version of the rules it was judged by.
 * Edit the .md files, not the generated output.
 */
import { createHash } from "node:crypto";
import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { join } from "node:path";

const root = process.cwd();
const files = ["services.md", "pricing.md", "qualified.md"] as const;

const docs: Record<string, string> = {};
const hash = createHash("sha256");
for (const f of files) {
  const text = readFileSync(join(root, "knowledge", f), "utf8").replace(/\r\n/g, "\n");
  docs[f] = text;
  hash.update(f).update("\0").update(text);
}
const version = hash.digest("hex").slice(0, 12);

mkdirSync(join(root, "lib", "knowledge"), { recursive: true });
writeFileSync(
  join(root, "lib", "knowledge", "source.generated.ts"),
  `// AUTO-GENERATED by scripts/embed-knowledge.mts. Do not edit; edit knowledge/*.md instead.\n` +
    `export const KNOWLEDGE_VERSION = ${JSON.stringify(version)};\n` +
    `export const KNOWLEDGE_DOCS = ${JSON.stringify(docs, null, 2)} as const;\n`,
);
console.log(`knowledge embedded (version ${version})`);
