# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (existing project) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Server-only. Its SHA-256 is stored in aangan_private.service_secret; RLS grants the pipeline write access via this header.
AANGAN_SERVICE_SECRET=<random 32+ chars>

# --- AI (Gemini Flash). Optional: without it the agent runs on the rules-only extractor. ---
GEMINI_API_KEY=<server-only>
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the model above has used its daily quota (free tier: about 20 requests per model per day)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_THINKING_BUDGET=0

# --- Designer handoff (Telegram Bot API). Optional: without it handoffs queue as "not configured" and can be retried. ---
TELEGRAM_BOT_TOKEN=<server-only>
TELEGRAM_DESIGNER_CHAT_ID=<group chat id for qualified-lead handoffs>
TELEGRAM_ALERTS_CHAT_ID=<chat id for escalations / callbacks; defaults to the designer chat>

# --- Voice ---
# Generic JSON voice webhook (/api/voice/mock), used by tests and any provider that can send turn-by-turn events.
VOICE_PROVIDER=mock
VOICE_WEBHOOK_SECRET=<random; the voice provider must send it as the x-aangan-webhook-secret header>
# Vaani: app.vaanivoice.ai > Developers > Webhooks > New End Point. URL https://<your-app>/api/vaani/webhook,
# event "Call Post-Processing", and put this same random value in its Secret field. Without it the webhook answers 503.
VAANI_WEBHOOK_SECRET=

# --- Calendly (books the consultation after a qualified call) ---
# Personal access token: Calendly > Integrations & apps > API and webhooks. Booking directly
# (Scheduling API) needs a paid plan (Standard+); on Free, the app sends a one-time booking link instead.
CALENDLY_TOKEN=
# The consultation event type's URI. Run `npm run calendly:event-types` to list yours.
CALENDLY_EVENT_TYPE_URI=
CALENDLY_INVITEE_TIMEZONE=Asia/Kolkata

# --- Later integrations (mock until their phase) ---
CRM_PROVIDER=mock

# --- Links in Telegram messages ---
APP_BASE_URL=http://localhost:3000

# --- Cost tracking. Leave a value blank if unknown: it shows as "unavailable", never as zero. ---
# Gemini 3.8 Flash paid-tier list prices in USD per 1M tokens, valid to 31 Dec 2026 (doubles from 1 Jan 2027).
# ESTIMATED: the free tier costs nothing. Check https://ai.google.dev/gemini-api/docs/pricing
GEMINI_USD_PER_M_INPUT=0.75
GEMINI_USD_PER_M_OUTPUT=3.75
USD_INR=88
# Voice provider cost per connected minute in INR (from your Vaani Labs plan)
VOICE_INR_PER_MINUTE=
# Fixed monthly platform cost in INR (Vercel + Supabase plans). 0 on free tiers.
PLATFORM_INR_PER_MONTH=
